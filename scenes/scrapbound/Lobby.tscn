[node name="Sec1Title" type="Label" parent="BriefingModal/Margin/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.75, 0.2, 1)
theme_override_fonts/font = ExtResource("5_font_bold")
theme_override_font_sizes/font_size = 9
text = "1. THE WORLD & MISSION (القصة والهدف)"

[node name="Sec1Body" type="Label" parent="BriefingModal/Margin/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_fonts/font = ExtResource("6_font_reg")
theme_override_font_sizes/font_size = 7
text = "Following a catastrophic nanotech e-waste mutation, aggressive amalgams swarm across the wasteland. High-frequency Telecom Towers are humanity's last defense: their electromagnetic emissions disrupt the nanotech communications grid! As technician Sami, protect your tower at all costs."
autowrap_mode = 2

[node name="Sec2Title" type="Label" parent="BriefingModal/Margin/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.95, 0.45, 1)
theme_override_fonts/font = ExtResource("5_font_bold")
theme_override_font_sizes/font_size = 9
text = "2. ECO-PURIFICATION & RECYCLING (تنقية الخردة والتدوير)"

[node name="Sec2Body" type="Label" parent="BriefingModal/Margin/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_fonts/font = ExtResource("6_font_reg")
theme_override_font_sizes/font_size = 7
text = "• Don't dump scrap — purify it! Walk near scrap piles and press [E] to collect raw materials.
• Take 10-15 scrap to the Recycler [E] to roll rare materials: Wood, Iron, Plastic, and Lithium Batteries.
• Use monster drops and scrap to power up your defenses."
autowrap_mode = 2

[node name="Sec3Title" type="Label" parent="BriefingModal/Margin/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.85, 1, 1)
theme_override_fonts/font = ExtResource("5_font_bold")
theme_override_font_sizes/font_size = 9
text = "3. WORKSHOP & CRAFTING ARSENAL (شجرة التصنيع)"

[node name="Sec3Body" type="Label" parent="BriefingModal/Margin/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_fonts/font = ExtResource("6_font_reg")
theme_override_font_sizes/font_size = 7
text = "• ⚡ Rapid-Fire SMG: 1 Iron + 1 Plastic (High rate of fire)
• 💥 Heavy Cannon: 2 Iron + 1 Wood (Heavy piercing 60 DMG)
• 🔥 Spread Shotgun: 1 Wood + 1 Iron + 1 Plastic (3-pellet spread)
• 🎯 Plasma Sniper: 2 Plastic + 1 Iron (Ultra long range)
• 🛡 Fortified Barrier: Press [Q] anywhere (Costs 2 raw materials) to block enemies!"
autowrap_mode = 2

[node name="Sec4Title" type="Label" parent="BriefingModal/Margin/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.4, 0.5, 1)
theme_override_fonts/font = ExtResource("5_font_bold")
theme_override_font_sizes/font_size = 9
text = "4. CONTROLS (أزرار التحكم)"

[node name="Sec4Body" type="Label" parent="BriefingModal/Margin/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_fonts/font = ExtResource("6_font_reg")
theme_override_font_sizes/font_size = 7
text = "• Move: [W, A, S, D] or [Arrow Keys]
• Fire Weapon: [SPACE] or [Left Mouse Button] or [K]
• Interact / Recycle / Craft: [E] or [L]
• Quick Barrier Deploy: [Q] or [O]"
autowrap_mode = 2

