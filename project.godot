; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SCRAPBOUND"
config/description="SCRAPBOUND - Two-Player Competitive Tower-Defense Survival Game"
run/main_scene="res://scenes/scrapbound/Lobby.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/sprites/ui/logo_icon.png"

[autoload]

NetworkManager="*res://scripts/scrapbound/NetworkManager.gd"
EventBus="*res://scripts/autoload/EventBus.gd"
InventoryManager="*res://scripts/autoload/InventoryManager.gd"
GameManager="*res://scripts/autoload/GameManager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

