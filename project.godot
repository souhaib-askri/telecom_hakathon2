[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="ScrapPiles"
2d_physics/layer_5="Turrets"
2d_physics/layer_6="Projectiles"
2d_physics/layer_7="Shockwaves"
2d_physics/layer_8="CoreTower"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.1, 1)
